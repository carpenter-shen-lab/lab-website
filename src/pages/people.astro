---
import PageLayout from '../layouts/PageLayout.astro';
import TeamCard from '../components/team/TeamCard.astro';
import { getTeamGrouped } from '../lib/team';
import { joinUrl } from '../lib/site';

const { leads, members } = await getTeamGrouped();
---

<PageLayout
  title="People | Carpenter-Shen Lab"
  description="Meet the researchers of the Carpenter-Shen Lab at Purdue University."
>
  <section style="background: var(--bg-content);">
    <!-- Content-sized intro keeps the heading aligned with News and Papers. -->
    <div class="team-banner">
      <div class="content-frame">
        <!-- Section header — sized to match the Research section -->
        <div class="text-center mb-10">
          <span class="section-label">Who We Are</span>
          <h1 class="mt-3" style="color: var(--text-heading); font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 700; letter-spacing: -0.015em;">
            Our Team
          </h1>
          <p class="mt-6 max-w-6xl mx-auto" style="color: var(--text-secondary); font-size: clamp(1.05rem, 1.25vw, 1.2rem); line-height: 1.6; text-align: justify; text-justify: inter-word;">
            Our computational lab combines expertise in computational biology, machine learning, and cell biology
            to push the boundaries of image-based drug discovery, in collaboration with biologists who create samples, images, and other omics data.
          </p>
          <div class="section-divider mt-7 w-24 mx-auto"></div>
        </div>

        <!-- PI Cards — span the same width as the member grid below -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-[88rem] mx-auto">
          {leads.map(member => <TeamCard member={member} variant="lead" />)}
        </div>
      </div>
    </div>

    <!-- Remaining team members follow the PI cards in normal document flow. -->
    <div class="pt-6 pb-16">
      <div class="content-frame">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 max-w-[88rem] mx-auto">
          {members.map(member => <TeamCard member={member} variant="member" />)}
        </div>
      </div>
    </div>

    <!-- Join Us call-to-action -->
    <div class="pb-24">
      <div class="content-frame text-center">
        <div class="section-divider mb-8 w-24 mx-auto"></div>
        <h2 class="mb-3" style="color: var(--text-heading); font-size: clamp(1.5rem, 2.5vw, 2.1rem); font-weight: 700; letter-spacing: -0.015em;">
          Want to join us?
        </h2>
        <p class="mb-8 max-w-xl mx-auto" style="color: var(--text-secondary); font-size: 1.05rem; line-height: 1.6; text-align: center;">
          We're always looking for curious, motivated people to join the lab.
        </p>
        <a
          href={joinUrl}
          class="join-us-btn"
        >
          Join Us
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Match the other pages' pt-10 without viewport-dependent centering. */
  .team-banner {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }

  .join-us-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 2.4rem;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1A1A1A;
    background: var(--purdue-rush);
    border-radius: 3px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .join-us-btn:hover {
    background: var(--purdue-field);
    transform: translateY(-1px);
  }
</style>
