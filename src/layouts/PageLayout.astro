---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../assets/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  brandAsH1?: boolean;
}

const { title, description, image, type, brandAsH1 = false } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} type={type}>
  {/* Re-forward the head slot so pages can inject JSON-LD through PageLayout. */}
  <slot name="head" slot="head" />
  <a href="#main-content" class="skip-nav">Skip to main content</a>
  <Header brandAsH1={brandAsH1} />
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>

<style>
  .skip-nav {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 9999;
    padding: 0.5rem 1rem;
    background: var(--purdue-rush);
    color: #1A1A1A;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 0 0 4px 4px;
    transition: top 0.15s ease;
  }
  .skip-nav:focus {
    top: 0;
    outline: 3px solid #1A1A1A;
    outline-offset: 2px;
  }
</style>
