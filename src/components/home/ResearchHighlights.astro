---
import { Image } from 'astro:assets';
import VideoCard from './VideoCard.astro';
import jumpGraphic from '../../assets/images/icons/jump_cellpainting-343x221.png';
import vistaLogo from '../../assets/images/icons/vista_logo-transparent.png';
import oasisLogo from '../../assets/images/icons/oasis_logo-trimmed.png';
import annePortrait from '../../assets/images/team/Anne_Carpenter_resized.png';
import runxiPortrait from '../../assets/images/team/Runxi_Shen_resized.jpg';
import rhoComposite from '../../assets/images/cells/rho-composite.png';
import rhoCys110TyrGfp from '../../assets/images/cells/rho-cys110tyr-gfp.png';

const projects = [
  {
    title: 'Rescuing Mislocalized Proteins',
    description:
      'When a critical protein ends up in the wrong place inside a cell, disease can follow. We systematically screen thousands of approved drugs to find ones that guide these proteins back to where they belong, turning medicines we already have into new cures.',
    url: 'https://vista-consortium.broadinstitute.org/',
    label: 'VISTA Consortium',
    graphic: vistaLogo,
    graphicAlt: 'VISTA Consortium logo: a mountain wrapped in a DNA double helix.',
    longName: 'Variant Integration for Screening Therapeutic Approaches',
    acronym: 'VISTA',
    reversed: true,
    logoShiftX: '-3rem',
    logoShiftY: '1rem',
  },
  {
    title: 'Predicting Chemical Safety',
    description:
      'We combine cellular imaging, transcriptomics, and proteomics across a global network of scientists to build predictive tools for chemical safety, reducing reliance on animal testing and bringing safer medicines to people faster.',
    url: 'https://oasisconsortium.org/',
    label: 'OASIS Consortium',
    graphic: oasisLogo,
    graphicAlt: 'OASIS Consortium logo: a stylized palm and caduceus in a warm gray disc.',
    longName: 'Omics for Assessing Signatures for Integrated Safety',
    acronym: 'OASIS',
    // This logo's artwork reads small at the shared height, so scale it up.
    logoScale: 1.16,
    logoShiftX: '3rem',
    logoShiftY: '1rem',
    // Drop the caption a touch for more breathing room below the tall disc.
    captionShiftY: '0.5rem',
  },
  {
    title: 'Mapping the Chemical Universe',
    description:
      'We are building the world’s largest open library of how cells respond to over 136,000 drugs and genetic changes, giving AI the training data it needs to accelerate the discovery of new medicines for any disease.',
    url: 'https://jump-cellpainting.broadinstitute.org/',
    label: 'JUMP Consortium',
    graphic: jumpGraphic,
    graphicAlt:
      'JUMP Cell Painting illustration: a field of stained cells with one magnified to show its organelles.',
    longName: 'Joint Undertaking in Morphological Profiling',
    acronym: 'JUMP',
    reversed: true,
    logoShiftX: '-3rem',
    // The illustration sits high in its frame; nudge it down to sit level.
    logoShiftY: '1rem',
  },
];

// Split a long name into tokens, marking the leading capital of each word that
// contributes a letter to the acronym (in order) so those initials can be
// tinted to match the acronym. Lowercase connectors ("for", "in") are skipped
// because their initial is not capitalised and so never matches.
function acronymParts(longName: string, acronym: string) {
  const letters = acronym.toUpperCase().split('');
  let idx = 0;
  return longName.split(/(\s+)/).map((token) => {
    const first = token.charAt(0);
    const isCapital = first !== '' && first === first.toUpperCase() && first !== first.toLowerCase();
    if (isCapital && idx < letters.length && first.toUpperCase() === letters[idx]) {
      idx += 1;
      return { initial: first, rest: token.slice(1) };
    }
    return { plain: token };
  });
}
---

<section id="research" class="research-section">
  <div class="research-overview">
    <div class="content-frame">
      <header class="research-intro">
        <div class="section-heading">
          <span class="home-kicker">What We Do</span>
          <h2>Research</h2>
        </div>
        <p class="research-lead">
          At the Carpenter-Shen Lab at Purdue University, we develop advanced methods and software to make discoveries in cell images. The rich information can reveal the causes and cures for diseases, and the impact of chemicals on biological systems. We work across all disease areas, from cancer and psychiatric disease to rare disorders and infectious disease.
        </p>
      </header>

      <div class="video-grid">
        <VideoCard
          speaker="Anne Carpenter"
          title="When Biology Meets Computer Science"
          videoId="KDQFUmDJ3nY"
          start={12}
          portrait={annePortrait}
          portraitAlt="Anne Carpenter"
          portraitPosition="center 32%"
          backdrop={rhoComposite}
        />
        <VideoCard
          speaker="Runxi Shen"
          title="Cell Painting for Rare Disease and Drug Discovery"
          videoId="wZFXWg_WfkU"
          portrait={runxiPortrait}
          portraitAlt="Runxi Shen"
          portraitPosition="center 30%"
          backdrop={rhoCys110TyrGfp}
        />
      </div>
    </div>
  </div>

  <div class="problems-section">
    <div class="content-frame">
      <header class="focus-intro">
        <div class="section-heading">
          <span class="home-kicker">Our Focus</span>
          <h2>Problems to solve</h2>
        </div>
      </header>

      <div class="project-list">
        {projects.map((project, index) => (
          <article class={`feature-row ${project.reversed ? 'is-reversed' : ''}`}>
            <figure
              class="feature-image"
              style={[
                project.logoScale ? `--logo-scale: ${project.logoScale};` : '',
                project.logoShiftX ? `--logo-shift-x: ${project.logoShiftX};` : '',
                project.logoShiftY ? `--logo-shift-y: ${project.logoShiftY};` : '',
                project.captionShiftY ? `--caption-shift-y: ${project.captionShiftY};` : '',
              ].join(' ').trim() || undefined}
            >
              <div class="feature-logo">
                <Image
                  src={project.graphic}
                  alt={project.graphicAlt}
                  widths={[320, 520, 720]}
                  sizes="(max-width: 767px) 72vw, 28vw"
                />
              </div>
              <figcaption class="feature-caption">
                <span class="caption-long">
                  {acronymParts(project.longName, project.acronym).map((part) =>
                    'initial' in part ? (
                      <><span class="caption-initial">{part.initial}</span>{part.rest}</>
                    ) : (
                      part.plain
                    )
                  )}
                </span>
                <span class="caption-acronym">({project.acronym})</span>
              </figcaption>
            </figure>

            <div class="feature-text">
              <span class="project-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="project-title">{project.title}</h3>
              <p class="project-description">{project.description}</p>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
              >
                <span>{project.label}</span>
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Runtime layout for the research section:
  //   1. Center the research overview in the viewport for #research landings
  //      (its height varies with content width; the CSS scroll-margin is the
  //      no-JS fallback).
  //   2. In the side-by-side layout, bottom-align each caption's acronym with
  //      its consortium link across the two columns. Their wrapping (and thus
  //      heights) depends on width, so no static value tracks them; we shift
  //      only the caption via a transform, preserving any --logo-shift-x.
  function updateResearchLayout() {
    const section = document.querySelector<HTMLElement>('.research-section');
    const overview = document.querySelector<HTMLElement>('.research-overview');
    if (section && overview) {
      const offset = (window.innerHeight - overview.getBoundingClientRect().height) / 2;
      section.style.scrollMarginTop = `${offset}px`;
    }

    const sideBySide = window.matchMedia('(min-width: 1024px)').matches;
    // Tight glyph bottom (not the box edge): a Range measures the actual rendered
    // text bounds, so we align what the eye sees rather than layout boxes. The
    // link has padding + an underline border below its text and a smaller font,
    // so its box bottom sits well below its glyphs; box alignment looked off.
    const glyphBottom = (el: Element) => {
      const range = document.createRange();
      range.selectNodeContents(el);
      return range.getBoundingClientRect().bottom;
    };
    document.querySelectorAll<HTMLElement>('.research-section .feature-row').forEach((row) => {
      const caption = row.querySelector<HTMLElement>('.feature-caption');
      const acronym = row.querySelector<HTMLElement>('.caption-acronym');
      const linkText = row.querySelector<HTMLElement>('.project-link span');
      if (!caption || !acronym || !linkText) return;
      // Reset to the CSS resting transform (keeps --logo-shift-x, no vertical shift).
      caption.style.transform = '';
      if (!sideBySide) return;
      // Align the acronym to the link, then apply any per-card downward nudge
      // (--caption-shift-y) to open a little space between the logo and caption.
      const delta = glyphBottom(linkText) - glyphBottom(acronym);
      caption.style.transform =
        `translate(var(--logo-shift-x, 0px), calc(${delta}px + var(--caption-shift-y, 0px)))`;
    });
  }

  // Coalesce bursts (notably rapid resize events) to one pass per frame.
  let updatePending = false;
  function scheduleUpdate() {
    if (updatePending) return;
    updatePending = true;
    requestAnimationFrame(() => {
      updatePending = false;
      updateResearchLayout();
    });
  }

  scheduleUpdate();
  window.addEventListener('load', scheduleUpdate);
  window.addEventListener('resize', scheduleUpdate);
  // Fonts change text wrapping after first paint, which moves the measured bottoms.
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(scheduleUpdate);
  }
  // Re-run after Astro view-transition navigations swap the DOM.
  document.addEventListener('astro:after-swap', scheduleUpdate);
</script>

<style>
  .research-section {
    /* No-JS fallback for centering the research overview on #research landings;
       the script above refines this to the exact measured height at runtime, so
       these constants only need to be approximately right. Centering a block of
       height H in a viewport V wants an offset of (V - H)/2 = 50svh - H/2 (svh
       so mobile browser-UI changes don't shift it). H grows ~linearly with
       content width (the video cards scale) until the frame caps at 104rem,
       giving H/2 = min(11.4vw + 14.2rem, 29rem); subtracting a min is adding
       a max, keeping it one CSS value. (Retuned when .research-overview's bottom
       pad was cut by ~5rem: −2.5vw fluid, −2.5rem at the cap, −1.6rem at the
       narrow end.) */
    scroll-margin-top: max(
      calc(50svh - 11.4vw - 14.2rem),
      calc(50svh - 29rem)
    );
    background: var(--bg-page);
  }

  .research-overview {
    /* Bottom pad is half the hero→heading gap; the problems-section top pad is
       the other half, so the two stack to one gap equal to that above (they no
       longer straddle a background color change now the page is one cream). */
    padding: clamp(5.5rem, 8vw, 8rem) 0 clamp(2.75rem, 4vw, 4rem);
    background: var(--bg-page);
  }

  .research-intro {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: end;
    column-gap: clamp(12rem, 18vw, 20rem);
    margin-bottom: clamp(3rem, 5vw, 4.75rem);
  }

  .focus-intro {
    display: grid;
    grid-template-columns: minmax(9rem, 0.28fr) minmax(0, 1.72fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    /* Same as .research-intro so the heading→content gap matches that section. */
    margin-bottom: clamp(3rem, 5vw, 4.75rem);
  }

  .focus-intro .section-heading {
    grid-column: 1 / -1;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .home-kicker {
    margin-bottom: 0.9rem;
    color: var(--purdue-aged);
    font-family: var(--font-label);
    font-size: clamp(1.05rem, 1.4vw, 1.22rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--text-heading);
    font-size: clamp(2.15rem, 4.2vw, 3.4rem);
    line-height: 1.05;
  }

  .focus-intro h2 {
    white-space: nowrap;
  }

  .research-lead {
    align-self: end;
    justify-self: end;
    width: 100%;
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.25vw, 1.18rem);
    line-height: 1.72;
    text-align: justify;
    text-justify: inter-word;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.4vw, 2rem);
  }

  .problems-section {
    /* Top pad pairs with .research-overview's bottom pad (see there). */
    padding: clamp(2.75rem, 4vw, 4rem) 0 clamp(7rem, 10vw, 10rem);
    background: var(--bg-page);
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .feature-row {
    display: grid;
    grid-template-areas: 'media text';
    grid-template-columns: minmax(25rem, 1fr) minmax(0, 1.15fr);
    min-height: clamp(24rem, 31vw, 27rem);
    overflow: hidden;
    border: 1px solid var(--border-card);
    border-radius: 12px;
    background: var(--bg-card);
    box-shadow: 0 10px 34px rgba(26, 26, 26, 0.055);
  }

  .feature-row.is-reversed {
    grid-template-areas: 'text media';
    grid-template-columns: minmax(0, 1.15fr) minmax(25rem, 1fr);
  }

  .feature-image {
    grid-area: media;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 2.2vw, 1.85rem);
    min-width: 0;
    margin: 0;
    padding: clamp(2.5rem, 4.5vw, 4.25rem) clamp(1rem, 2.1vw, 1.75rem);
    background: var(--bg-card);
  }

  .feature-logo {
    display: flex;
    /* Compact (not flex:1): the logo and its caption sit together as one
       centered unit rather than the logo floating up and the caption pinned
       to the bottom of the panel. */
    flex: 0 0 auto;
    width: 100%;
    min-height: 0;
    align-items: center;
    justify-content: center;
    /* Per-logo nudge: X pulls the logo toward its text column (the media and
       text columns aren't equal width, so a centered logo sits too far out);
       Y fine-tunes the vertical position. The caption tracks the same X below. */
    transform: translate(var(--logo-shift-x, 0), var(--logo-shift-y, 0));
  }

  .feature-logo :global(img) {
    display: block;
    width: auto;
    height: calc(clamp(8.5rem, 13vw, 11rem) * var(--logo-scale, 1));
    max-width: min(100%, 21rem);
    object-fit: contain;
  }

  .feature-caption {
    display: flex;
    flex: 0 0 auto;
    width: 100%;
    max-width: none;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-secondary);
    font-family: var(--font-body);
    text-align: center;
    /* Resting transform: track the logo's horizontal shift. The script overrides
       this to also bottom-align the acronym with the consortium link. */
    transform: translate(var(--logo-shift-x, 0), 0);
  }

  .caption-long {
    color: var(--text-primary);
    font-size: clamp(0.98rem, 1.5vw, 1.3rem);
    font-weight: 600;
    line-height: 1.45;
  }

  /* The initial of each word that spells the acronym, tinted to match it. */
  .caption-initial {
    color: var(--purdue-aged);
    font-weight: 700;
  }

  .caption-acronym {
    color: var(--purdue-aged);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .feature-text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2.75rem, 5vw, 5rem);
  }

  .project-index {
    margin-bottom: 1rem;
    color: var(--purdue-aged);
    font-family: var(--font-label);
    /* Kept in step with .project-link for a consistent label scale. */
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .project-title {
    margin: 0 0 1.2rem;
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.16;
  }

  .project-description {
    max-width: 62ch;
    margin: 0 0 1.75rem;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.25vw, 1.08rem);
    line-height: 1.72;
    text-align: justify;
    text-justify: inter-word;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0 0.25rem;
    border-bottom: 2px solid var(--purdue-aged);
    color: var(--purdue-aged);
    font-family: var(--font-label);
    /* Matches .project-index for a consistent label scale. */
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .project-link svg {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-link:hover {
    border-color: var(--purdue-rush);
    color: var(--purdue-aged);
  }

  .project-link:hover svg {
    transform: translateX(0.25rem);
  }

  .project-link:focus-visible {
    border-radius: 2px;
    outline: 3px solid var(--purdue-aged);
    outline-offset: 4px;
  }

  @media (max-width: 1023px) {
    .research-intro,
    .focus-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .research-lead {
      width: min(66ch, 100%);
    }

    .feature-row,
    .feature-row.is-reversed {
      grid-template-areas:
        'media'
        'text';
      grid-template-columns: 1fr;
      min-height: 0;
    }

    /* The per-logo nudge (--logo-shift-x/-y) only compensates for the unequal
       two-column desktop layout; in the stacked single-column layout the media
       panel is centered, so the shift would push logos/captions off-center (and
       can crowd OASIS toward its padding). Reset it here. The JS clears the
       caption's inline transform on mobile, so this rule governs it too. */
    .feature-logo,
    .feature-caption {
      transform: none;
    }

    .feature-image {
      min-height: 19rem;
      padding: 2.75rem 1.5rem 2.5rem;
    }

    .feature-text {
      padding: clamp(2.25rem, 4vw, 3.5rem);
    }
  }

  @media (max-width: 767px) {
    .research-lead {
      width: min(56ch, 100%);
      text-align: left;
    }

    .video-grid {
      grid-template-columns: 1fr;
    }

    .feature-row,
    .feature-row.is-reversed {
      grid-template-areas:
        'media'
        'text';
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .feature-image {
      min-height: 18rem;
      padding: 2.5rem 1.5rem 2.25rem;
    }

    .feature-logo :global(img) {
      height: calc(clamp(8rem, 32vw, 10rem) * var(--logo-scale, 1));
      max-width: 78%;
    }

    .feature-text {
      padding: 2.5rem 1.75rem 2.75rem;
    }

    .project-description {
      max-width: none;
      text-align: left;
    }
  }

  @media (max-width: 420px) {
    .feature-text {
      padding-right: 1.35rem;
      padding-left: 1.35rem;
    }

    .focus-intro h2 {
      font-size: clamp(1.65rem, 8.5vw, 2.15rem);
    }

    .caption-long {
      font-size: clamp(0.88rem, 3.6vw, 1.02rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-link,
    .project-link svg {
      transition: none;
    }
  }
</style>
