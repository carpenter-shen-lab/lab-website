---
import { Image } from 'astro:assets';
import jumpLogo from '../../assets/images/icons/jump_cellpainting-343x221.png';
import vistaLogo from '../../assets/images/icons/vista_logo-transparent.png';
import oasisLogo from '../../assets/images/icons/oasis_logo-trimmed.png';

const base = import.meta.env.BASE_URL;

// Research problems, in priority order. Each "media" is a Purdue-branded
// colour placeholder for now; real project imagery drops in here later.
const projects = [
  {
    title: 'Rescuing Mislocalized Proteins',
    description:
      'When a critical protein ends up in the wrong place inside a cell, disease can follow. We systematically screen thousands of approved drugs to find ones that guide these proteins back to where they belong, turning medicines we already have into new cures.',
    url: 'https://vista-consortium.broadinstitute.org/',
    label: 'VISTA Consortium',
    logo: vistaLogo,
    logoAlt: 'VISTA Consortium logo: a mountain wrapped in a DNA double helix.',
    figMax: '340px',
  },
  {
    title: 'Predicting Chemical Safety',
    description:
      'We combine cellular imaging, transcriptomics, and proteomics across a global network of scientists to build predictive tools for chemical safety, reducing reliance on animal testing and bringing safer medicines to people faster.',
    url: 'https://oasisconsortium.org/',
    label: 'OASIS Consortium',
    logo: oasisLogo,
    logoAlt: 'OASIS Consortium logo: a stylized palm and caduceus in a blue disc.',
    figMax: '270px',
    reversed: true,
  },
  {
    title: 'Mapping the Chemical Universe',
    description:
      'We are building the world’s largest open library of how cells respond to over 136,000 drugs and genetic changes, giving AI the training data it needs to accelerate the discovery of new medicines for any disease.',
    url: 'https://jump-cellpainting.broadinstitute.org/',
    label: 'JUMP-Cell Painting Consortium',
    from: 'var(--purdue-field)',
    to: 'var(--purdue-aged)',
    image: jumpLogo,
    imageAlt:
      'JUMP Cell Painting illustration: a field of stained cells with one magnified to show its organelles.',
  },
];
---

<section id="research" class="scroll-mt-16" style="background: var(--bg-content);">
  <!-- Full-viewport video banner: jumping to #research shows only this -->
  <div class="research-banner px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto w-full">
      <!-- Section header -->
      <div class="text-center mb-10">
        <span class="section-label">What We Do</span>
        <h2 class="mt-3" style="color: var(--text-heading);">Research</h2>
        <p class="mt-6 max-w-6xl mx-auto" style="color: var(--text-secondary); font-size: clamp(1.05rem, 1.25vw, 1.2rem); line-height: 1.6; text-align: justify; text-justify: inter-word;">
          We develop advanced methods and software to make discoveries in cell images. The rich information can reveal the causes and cures for diseases, and the impact of chemicals on biological systems. We work across all disease areas, from cancer and psychiatric disease to rare disorders and infectious disease.
        </p>
        <div class="section-divider mt-7 w-24 mx-auto"></div>
      </div>

      <!-- Videos: Anne's YouTube on left, Runxi's YouTube on right -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Anne's YouTube: Lab overview / research talk -->
      <div>
        <div class="rounded-xl overflow-hidden shadow-lg" style="background: var(--bg-card); border: 1px solid var(--border-card);">
          <iframe
            src="https://www.youtube.com/embed/KDQFUmDJ3nY?start=12"
            class="w-full"
            style="min-height: 300px;"
            frameborder="0"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            title="Anne Carpenter — Research Talk"
          ></iframe>
        </div>
        <p class="video-caption">Anne Carpenter: When Biology Meets Computer Science</p>
      </div>

      <!-- Runxi's YouTube: Cell Painting for Rare Disease and Drug Discovery -->
      <div>
        <div class="rounded-xl overflow-hidden shadow-lg" style="background: var(--bg-card); border: 1px solid var(--border-card);">
          <iframe
            src="https://www.youtube.com/embed/wZFXWg_WfkU"
            class="w-full"
            style="min-height: 300px;"
            frameborder="0"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            title="Cell Painting for Rare Disease and Drug Discovery"
          ></iframe>
        </div>
        <p class="video-caption">Runxi Shen: Cell Painting for Rare Disease and Drug Discovery</p>
      </div>
      </div>
    </div>
  </div>

  <!-- Problems to solve — separate block, revealed on scroll below the banner -->
  <div class="px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    <div class="max-w-7xl mx-auto">
      <!-- Problems we want to solve — alternating text / media rows -->
      <div class="text-center mb-16">
        <span class="section-label">Our Focus</span>
        <h2 class="mt-4" style="color: var(--text-heading);">Problems to solve</h2>
        <div class="section-divider mt-8 w-24 mx-auto"></div>
      </div>

      <div class="project-list">
      {projects.map((p) => {
        const fig = p.image ?? p.logo;
        return fig ? (
          /* Feature row — consortium logo/illustration overlapping a gold text
             panel. `reversed` mirrors it (image right, text left) for rhythm. */
          <article
            class={`project-row feature-row ${p.reversed ? 'is-reversed' : ''}`}
            style={p.figMax ? `--fig-max: ${p.figMax}` : undefined}
          >
            <figure class="feature-image">
              <Image src={fig} alt={p.imageAlt ?? p.logoAlt} sizes="(max-width: 767px) 70vw, 34vw" />
            </figure>

            <div class="feature-text">
              <h3 class="project-title">{p.title}</h3>
              <p class="project-desc">{p.description}</p>
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="project-link feature-link">
                {p.label}
                <svg class="project-link-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </article>
        ) : (
          <article class="project-row">
            <div class="project-media" style={`--from: ${p.from}; --to: ${p.to};`}>
              <span class="project-media-label">Image coming soon</span>
            </div>
            <div class="project-text">
              <h3 class="project-title">{p.title}</h3>
              <p class="project-desc">{p.description}</p>
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="project-link">
                Learn more
                <svg class="project-link-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </article>
        );
      })}
      </div>
    </div>
  </div>
</section>

<style>
  /* Full-viewport banner: fills the screen below the fixed 65px nav, content
     vertically centered. min-height (not height) lets it grow on short windows
     so nothing clips. svh keeps it stable across browser/fullscreen chrome. */
  .research-banner {
    min-height: calc(100svh - 65px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }
  @supports not (height: 100svh) {
    .research-banner { min-height: calc(100vh - 65px); }
  }

  .video-caption {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-heading);
  }

  /* ─── Project rows ─── */
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }
  .project-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  /* Alternate the media to the opposite side on every other row */
  .project-row.is-reversed .project-media {
    order: 2;
  }

  /* Media placeholder */
  .project-media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
    background:
      repeating-linear-gradient(
        77deg,
        rgba(255, 255, 255, 0.06) 0,
        rgba(255, 255, 255, 0.06) 2px,
        transparent 2px,
        transparent 26px
      ),
      linear-gradient(135deg, var(--from) 0%, var(--to) 100%);
    box-shadow: 0 1px 2px rgba(26, 26, 26, 0.05), 0 14px 40px rgba(142, 111, 62, 0.12);
  }
  .project-media-label {
    position: absolute;
    bottom: 0.9rem;
    right: 1.1rem;
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.55);
  }

  /* Text block */
  .project-title {
    font-family: var(--font-display);        /* Plus Jakarta Sans, site heading font */
    font-weight: 700;
    font-size: clamp(1.5rem, 2.3vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--text-heading);
    margin: 0 0 1.1rem 0;
  }
  .project-desc {
    font-family: var(--font-body);           /* Plus Jakarta Sans, site body font */
    font-weight: 400;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    text-align: justify;
    text-justify: inter-word;
    margin: 0 0 1.5rem 0;
  }
  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--purdue-aged);
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .project-link:hover {
    color: var(--purdue-rush);
    border-bottom-color: var(--purdue-rush);
  }
  .project-link-arrow {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 0.18s ease;
  }
  .project-link:hover .project-link-arrow {
    transform: translateX(4px);
  }

  /* ─── Feature row: logo / illustration lapping onto a gold text panel ────
     Flex + negative margin so the overlap holds for ANY figure width. The
     figure keeps its natural size on the outer edge; the gold panel is pulled
     back under the figure's inner edge by --lap. --fig-max sets the figure's
     display width per project (JUMP's big illustration vs. compact logos). */
  .feature-row {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0;
    --lap: 4.5rem;             /* how far the panel tucks under the figure */
  }
  .feature-image {
    flex: 0 0 auto;
    z-index: 2;                /* figure sits above the panel */
    margin: 0;
  }
  .feature-image :global(img) {
    display: block;
    width: var(--fig-max, 520px);
    max-width: 46vw;           /* never overpower the row on mid-width screens */
    height: auto;
    filter: drop-shadow(0 14px 24px rgba(142, 111, 62, 0.20));
  }
  /* The text block IS the gold panel; the figure laps onto its inner edge */
  .feature-text {
    flex: 1 1 auto;
    z-index: 1;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: linear-gradient(135deg, #F5E8C2 0%, #ECD8A2 100%);
    box-shadow: 0 12px 34px rgba(142, 111, 62, 0.10);
    /* slide under the figure, then pad past the overlap so text stays clear */
    margin-left: calc(-1 * var(--lap));
    padding: 2.5rem 3rem 2.5rem calc(var(--lap) + 2rem);
  }

  /* ─── Reversed feature row: text left, figure lapping from the right ─── */
  .feature-row.is-reversed {
    flex-direction: row-reverse;
  }
  .feature-row.is-reversed .feature-text {
    /* mirror the gradient + overlap side */
    background: linear-gradient(225deg, #F5E8C2 0%, #ECD8A2 100%);
    margin-left: 0;
    margin-right: calc(-1 * var(--lap));
    padding: 2.5rem calc(var(--lap) + 2rem) 2.5rem 3rem;
  }
  .feature-link {
    font-size: 1.2rem;        /* a touch larger than the standard project link */
    margin-top: 0.35rem;
  }
  .feature-link .project-link-arrow {
    width: 1.2rem;
    height: 1.2rem;
  }
  .feature-text .project-desc {
    color: #4a4334;        /* warm dark for contrast on the gold panel */
  }

  /* ─── Mobile: stack, media always on top ─── */
  @media (max-width: 767px) {
    .project-row,
    .project-row.is-reversed {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .project-row.is-reversed .project-media {
      order: 0;
    }
    .project-desc {
      text-align: left;
    }

    /* Feature row collapses: figure on top dips onto the gold panel below.
       Reversed rows collapse the same way (logo on top, text below). */
    .feature-row,
    .feature-row.is-reversed {
      flex-direction: column;
      gap: 0;
    }
    .feature-image,
    .feature-row.is-reversed .feature-image {
      align-self: center;
      margin: 0;
      transform: translateY(1.75rem);
      z-index: 2;
    }
    .feature-image :global(img) {
      width: min(var(--fig-max, 280px), 72vw);
      max-width: 280px;
      margin: 0 auto;
    }
    .feature-text,
    .feature-row.is-reversed .feature-text {
      width: 100%;
      margin: 0;
      padding: 3.5rem 1.75rem 2.25rem;
      text-align: center;
    }
    .feature-text .project-desc {
      text-align: left;
    }
  }
</style>
