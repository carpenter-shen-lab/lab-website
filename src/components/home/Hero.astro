---
import { getImage } from 'astro:assets';
import cellNetworkMotion from '../../assets/images/hero/hero-cell-network-circle-champagne-motion-v3-4k-crisp.png';
import { withBase } from '../../lib/paths';

const [networkMotionSmall, networkMotionMedium, networkMotionLarge] = await Promise.all([
  getImage({ src: cellNetworkMotion, format: 'webp', width: 1200, quality: 96 }),
  getImage({ src: cellNetworkMotion, format: 'webp', width: 2400, quality: 96 }),
  getImage({ src: cellNetworkMotion, format: 'webp', width: 3840, quality: 96 }),
]);
---

<section class="hero-section">
  <div class="hero-network-frame" aria-hidden="true">
    <img
      class="hero-network-motion"
      src={networkMotionSmall.src}
      srcset={`${networkMotionSmall.src} ${networkMotionSmall.attributes.width}w, ${networkMotionMedium.src} ${networkMotionMedium.attributes.width}w, ${networkMotionLarge.src} ${networkMotionLarge.attributes.width}w`}
      sizes="(max-width: 700px) 285vw, (max-width: 1100px) 209vw, 168vw"
      width={networkMotionLarge.attributes.width}
      height={networkMotionLarge.attributes.height}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="hero-content animate-fade-in">
    <!-- The page heading is the header wordmark "Carpenter-Shen Lab" (top-left),
         so this hero statement remains a second-level heading. -->
    <h2 class="hero-title">
      <span class="hero-lab-name">Carpenter-Shen Lab</span>
      <span class="hero-promise">
        <span class="hero-connector">From</span>
        <span class="hero-signature hero-cells">Cells</span>
        <span class="hero-connector">to</span>
        <span class="hero-signature hero-cures">Cures</span>
      </span>
    </h2>

    <p class="hero-lead">
      Very few people get to solve puzzles all day long <br class="lead-break" />and directly help patients suffering from disease.
    </p>

    <div class="hero-ctas">
      <a href={withBase('/#research')} class="hero-cta">Our Research</a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    display: flex;
    align-items: center;
    min-height: max(42rem, calc(100svh - 4rem));
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    background: var(--bg-page);
  }

  .hero-section::after {
    content: '';
    position: absolute;
    z-index: 0;
    right: 0;
    bottom: 0;
    left: 0;
    height: clamp(4rem, 10vh, 7rem);
    background: linear-gradient(to bottom, transparent, var(--bg-page));
    pointer-events: none;
  }

  /* This wrapper owns placement. Only the square image inside it rotates. */
  .hero-network-frame {
    --network-scale: 1.9;
    position: absolute;
    z-index: 0;
    top: 50%;
    right: 0;
    width: min(96vw, calc(100svh + 26rem), 96rem);
    aspect-ratio: 1;
    overflow: hidden;
    /* Softer edge fade on both sides so more of the network remains visible
       without the frame feeling like it was hard-cropped. */
    /* Left side reveals more of the network: the ramp starts near the edge and
       climbs through higher mid-opacities (many stops = smooth) to full opacity
       by ~20%, so more image shows through on the left. The right side keeps its
       shorter fade. All stops are percentages so the balance holds across sizes. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      transparent 6%,
      rgba(0, 0, 0, 0.10) 9%,
      rgba(0, 0, 0, 0.24) 12%,
      rgba(0, 0, 0, 0.42) 15%,
      rgba(0, 0, 0, 0.62) 18%,
      rgba(0, 0, 0, 0.82) 21%,
      #000 24%,
      #000 80%,
      rgba(0, 0, 0, 0.28) 88%,
      rgba(0, 0, 0, 0.10) 94%,
      transparent 98%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      transparent 6%,
      rgba(0, 0, 0, 0.10) 9%,
      rgba(0, 0, 0, 0.24) 12%,
      rgba(0, 0, 0, 0.42) 15%,
      rgba(0, 0, 0, 0.62) 18%,
      rgba(0, 0, 0, 0.82) 21%,
      #000 24%,
      #000 80%,
      rgba(0, 0, 0, 0.28) 88%,
      rgba(0, 0, 0, 0.10) 94%,
      transparent 98%
    );
    transform: translateY(-50%);
    pointer-events: none;
  }

  .hero-network-motion {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    transform: scale(var(--network-scale));
    transform-origin: center;
    animation: network-rotation 120s linear infinite;
    will-change: transform;
  }

  @keyframes network-rotation {
    from { transform: scale(var(--network-scale)) rotate(0deg); }
    to { transform: scale(var(--network-scale)) rotate(360deg); }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: min(44rem, calc(100% - (var(--site-gutter) * 2)));
    margin-left: var(--site-gutter);
    margin-right: auto;
    padding: clamp(5rem, 10vh, 8rem) 0 4rem;
    text-align: left;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0 0 2.75rem;
    color: var(--text-primary);
    text-align: left;
  }

  .hero-lab-name {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.6vw, 4rem);
    font-weight: 700;
    line-height: 1.04;
  }

  .hero-promise {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.2em;
    font-size: clamp(2.65rem, 4.8vw, 5.2rem);
    line-height: 1;
  }

  .hero-connector {
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: 0.48em;
    font-weight: 600;
  }

  .hero-signature {
    display: inline-block;
    font-family: var(--font-cure);
    font-optical-sizing: auto;
    font-style: normal;
    font-weight: 900;
  }

  .hero-cells {
    color: var(--purdue-steel);
  }

  .hero-cures {
    color: var(--purdue-aged);
  }

  .hero-lead {
    max-width: 39rem;
    margin: 0 0 2.75rem;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.55vw, 1.55rem);
    font-weight: 500;
    line-height: 1.55;
    text-align: left;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  .hero-ctas {
    display: flex;
    justify-content: flex-start;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2.3rem;
    border: 1px solid var(--text-primary);
    border-radius: 3px;
    background: var(--text-primary);
    box-shadow: 0 8px 24px rgba(26, 26, 26, 0.18);
    color: var(--bg-page);
    font-family: var(--font-label);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .hero-cta:hover {
    border-color: var(--purdue-aged);
    background: var(--purdue-aged);
    color: var(--bg-page);
    transform: translateY(-1px);
  }

  .hero-cta:focus-visible {
    outline: 3px solid var(--purdue-aged);
    outline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .hero-network-frame {
      top: 57%;
      right: -10vw;
      width: min(122vw, calc(100svh + 20rem));
      opacity: 0.46;
    }

    .hero-content {
      width: min(38rem, calc(100% - (var(--site-gutter) * 2)));
      margin-left: var(--site-gutter);
    }

    .hero-lab-name {
      font-size: clamp(2rem, 5.2vw, 3.5rem);
    }

    .hero-promise {
      font-size: clamp(2.6rem, 7vw, 4.5rem);
    }
  }

  @media (min-width: 100rem) {
    .hero-network-frame {
      --network-scale: 1.5;
      right: 0;
      width: min(98vw, 94rem, calc(100svh + 26rem));
    }

    .hero-content {
      width: min(40rem, calc(100% - (var(--site-gutter) * 2)));
      margin-left: var(--site-gutter);
    }
  }

  @media (max-width: 700px) {
    .hero-section {
      align-items: flex-start;
      min-height: max(45rem, 100svh);
    }

    .hero-network-frame {
      top: 66%;
      right: -26vw;
      width: min(168vw, 46rem);
      opacity: 0.24;
    }

    .hero-content {
      width: calc(100% - (var(--site-gutter) * 2));
      margin-left: var(--site-gutter);
      padding: clamp(8.5rem, 19vh, 10rem) 0 6rem;
    }

    .hero-title {
      gap: 0.35rem;
      margin-bottom: 2.25rem;
    }

    .hero-lab-name {
      font-size: clamp(1.8rem, 8vw, 2.7rem);
    }

    .hero-promise {
      font-size: clamp(2.4rem, 12.5vw, 3.4rem);
    }

    .hero-lead {
      max-width: 31rem;
      margin-bottom: 2.25rem;
      font-size: clamp(1.08rem, 5vw, 1.3rem);
      text-shadow:
        0 1px 0 rgba(255, 255, 255, 0.92),
        0 0 18px var(--bg-page);
    }

    .lead-break { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-network-motion {
      animation: none;
      will-change: auto;
    }
  }
</style>
