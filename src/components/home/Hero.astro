---
import { getImage } from 'astro:assets';
import cellNetworkMotion from '../../assets/images/hero/hero-cell-network-circle-champagne-motion-v3.png';
import cellNetworkStatic from '../../assets/images/hero/hero-cell-network-circle-champagne-v2.png';
import { withBase } from '../../lib/paths';

const [networkMotion, networkStatic] = await Promise.all([
  getImage({ src: cellNetworkMotion, format: 'webp', width: 1080, quality: 88 }),
  getImage({ src: cellNetworkStatic, format: 'webp', width: 2400, quality: 84 }),
]);
---

<section class="hero-section">
  <div class="hero-network-frame" aria-hidden="true">
    <img
      class="hero-network-static"
      src={networkStatic.src}
      width={networkStatic.attributes.width}
      height={networkStatic.attributes.height}
      alt=""
      decoding="async"
    />
    <img
      class="hero-network-motion"
      src={networkMotion.src}
      width={networkMotion.attributes.width}
      height={networkMotion.attributes.height}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="hero-content animate-fade-in">
    <!-- The page heading is the header wordmark "Carpenter-Shen Lab" (top-left),
         so this hero statement remains a second-level heading. -->
    <h2 class="hero-title">
      <span class="hero-lab-name">Carpenter-Shen Lab</span>
      <span class="hero-promise">
        <span class="hero-connector">From</span>
        <span class="hero-signature hero-cells">Cells</span>
        <span class="hero-connector">to</span>
        <span class="hero-signature hero-cures">Cures</span>
      </span>
    </h2>

    <p class="hero-lead">
      Very few people get to solve puzzles all day long <br class="lead-break" />and directly help patients suffering from disease.
    </p>

    <div class="hero-ctas">
      <a href={withBase('/#research')} class="hero-cta">Our Research</a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    display: flex;
    align-items: center;
    min-height: max(42rem, calc(100svh - 4rem));
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    background: var(--bg-page);
  }

  .hero-section::after {
    content: '';
    position: absolute;
    z-index: 0;
    right: 0;
    bottom: 0;
    left: 0;
    height: clamp(4rem, 10vh, 7rem);
    background: linear-gradient(to bottom, transparent, var(--bg-page));
    pointer-events: none;
  }

  /* This wrapper owns placement. Only the square image inside it rotates. */
  .hero-network-frame {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: 1vw;
    width: min(88vw, calc(100svh + 18rem), 84rem);
    aspect-ratio: 1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      transparent 8%,
      rgba(0, 0, 0, 0.35) 13%,
      #000 20%,
      #000 62%,
      rgba(0, 0, 0, 0.35) 72%,
      transparent 82%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      transparent 8%,
      rgba(0, 0, 0, 0.35) 13%,
      #000 20%,
      #000 62%,
      rgba(0, 0, 0, 0.35) 72%,
      transparent 82%
    );
    transform: translateY(-50%);
    pointer-events: none;
  }

  .hero-network-motion {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    transform-origin: center;
    animation: network-rotation 120s linear infinite;
    will-change: transform;
  }

  /* The supplied full-width reference becomes the static fallback for users
     who disable motion. Its circle is aligned to the same square frame. */
  .hero-network-static {
    display: none;
    position: absolute;
    top: 0;
    left: -166%;
    width: 300%;
    height: 100%;
    max-width: none;
    object-fit: fill;
    transform: scale(1.9);
    transform-origin: 72% center;
  }

  @keyframes network-rotation {
    from { transform: scale(1.9) rotate(0deg); }
    to { transform: scale(1.9) rotate(360deg); }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: min(44vw, 42rem);
    margin-left: max(3rem, calc((100vw - 80rem) / 2 + 3rem));
    padding: clamp(5rem, 10vh, 8rem) 0 4rem;
    text-align: left;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0 0 2.75rem;
    color: var(--text-primary);
    text-align: left;
  }

  .hero-lab-name {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.6vw, 4rem);
    font-weight: 700;
    line-height: 1.04;
  }

  .hero-promise {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.2em;
    font-size: clamp(2.65rem, 4.8vw, 5.2rem);
    line-height: 1;
  }

  .hero-connector {
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: 0.48em;
    font-weight: 600;
  }

  .hero-signature {
    display: inline-block;
    font-family: var(--font-cure);
    font-optical-sizing: auto;
    font-style: normal;
    font-weight: 900;
  }

  .hero-cells {
    color: var(--purdue-steel);
  }

  .hero-cures {
    color: var(--purdue-aged);
  }

  .hero-lead {
    max-width: 39rem;
    margin: 0 0 2.75rem;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.55vw, 1.55rem);
    font-weight: 500;
    line-height: 1.55;
    text-align: left;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  .hero-ctas {
    display: flex;
    justify-content: flex-start;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2.3rem;
    border: 1px solid var(--text-primary);
    border-radius: 3px;
    background: var(--text-primary);
    box-shadow: 0 8px 24px rgba(26, 26, 26, 0.18);
    color: var(--bg-page);
    font-family: var(--font-label);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .hero-cta:hover {
    border-color: var(--purdue-aged);
    background: var(--purdue-aged);
    color: var(--bg-page);
    transform: translateY(-1px);
  }

  .hero-cta:focus-visible {
    outline: 3px solid var(--purdue-rush);
    outline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .hero-network-frame {
      top: 57%;
      right: -12vw;
      width: min(110vw, calc(100svh + 14rem));
      opacity: 0.46;
    }

    .hero-content {
      width: min(64vw, 38rem);
      margin-left: 3rem;
    }

    .hero-lab-name {
      font-size: clamp(2rem, 5.2vw, 3.5rem);
    }

    .hero-promise {
      font-size: clamp(2.6rem, 7vw, 4.5rem);
    }
  }

  @media (max-width: 1023px) {
    .hero-content {
      margin-left: 2rem;
    }
  }

  @media (max-width: 700px) {
    .hero-section {
      align-items: flex-start;
      min-height: max(45rem, 100svh);
    }

    .hero-network-frame {
      top: 66%;
      right: -30vw;
      width: min(150vw, 40rem);
      opacity: 0.24;
    }

    .hero-content {
      width: calc(100% - 3rem);
      margin-left: 1.5rem;
      padding: clamp(8.5rem, 19vh, 10rem) 0 6rem;
    }

    .hero-title {
      gap: 0.35rem;
      margin-bottom: 2.25rem;
    }

    .hero-lab-name {
      font-size: clamp(1.8rem, 8vw, 2.7rem);
    }

    .hero-promise {
      font-size: clamp(2.4rem, 12.5vw, 3.4rem);
    }

    .hero-lead {
      max-width: 31rem;
      margin-bottom: 2.25rem;
      font-size: clamp(1.08rem, 5vw, 1.3rem);
      text-shadow:
        0 1px 0 rgba(255, 255, 255, 0.92),
        0 0 18px var(--bg-page);
    }

    .lead-break { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-network-motion {
      display: none;
      animation: none;
      will-change: auto;
    }

    .hero-network-static {
      display: block;
    }
  }
</style>
