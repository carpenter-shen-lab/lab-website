---
import { getImage } from 'astro:assets';
import rhoGfp from '../../assets/images/cells/rho-gfp.png';
import rhoComposite from '../../assets/images/cells/rho-composite.png';
import rhoVarGfp from '../../assets/images/cells/rho-cys110tyr-gfp.png';
import cures2 from '../../assets/images/cells2cures-2.png';
import { withBase } from '../../lib/paths';

// Hand-drawn "2" wordmark glyph (white brushstroke on transparent). Served as
// optimized WebP so the alpha edge stays crisp while the file stays small.
const two = await getImage({ src: cures2, format: 'webp', width: 1111, quality: 90 });

// VarChamp Batch-13 cell images (cpg0020-varchamp), reference channel palette.
// Left -> right: RHO protein (GFP) -> RHO morphology composite -> RHO_Cys110Tyr
// protein (GFP). Served as optimized WebP from the 1080x1080 masters.
const [panelL, panelM, panelR] = await Promise.all([
  getImage({ src: rhoGfp, format: 'webp', width: 1080, quality: 82 }),
  getImage({ src: rhoComposite, format: 'webp', width: 1080, quality: 82 }),
  getImage({ src: rhoVarGfp, format: 'webp', width: 1080, quality: 82 }),
]);
---

<section class="hero-section relative min-h-screen flex items-center justify-center overflow-hidden">

  <!-- Cell-image triptych: protein -> morphology -> variant protein -->
  <div class="hero-triptych" aria-hidden="true">
    <div class="hero-panel" style={`background-image: url(${panelL.src})`}></div>
    <div class="hero-panel" style={`background-image: url(${panelM.src})`}></div>
    <div class="hero-panel" style={`background-image: url(${panelR.src})`}></div>
  </div>

  <!-- Legibility scrim: deepens the center behind the text, keeps the cells
       vivid toward the edges. No top fade, so the imagery meets the nav cleanly. -->
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="relative z-10 hero-content animate-fade-in">
    <!-- The page heading is the header wordmark "Carpenter-Shen Lab" (top-left),
         so the "Cells 2 Cures" mark here is a second-level heading. The wordmark
         markup and its protected hand-drawn "2" glyph are unchanged. -->
    <h2 class="hero-title" aria-label="Cells to Cures">
      <span class="cw cw-cell">Cells</span><span class="cw-two" aria-hidden="true"><img src={two.src} width={two.attributes.width} height={two.attributes.height} alt="" /></span><span class="cw cw-cure">Cures</span>
    </h2>

    <p class="hero-lead">
      Very few people get to solve puzzles all day long <br class="lead-break" />and directly help patients suffering from disease.
    </p>

    <div class="hero-ctas">
      <a href={withBase('/#research')} class="hero-cta">Our Research</a>
    </div>
  </div>
</section>

<style>
  /* Pull the hero up under the fixed header and restore that space as padding,
     so the imagery is continuous from the very top (no seam under the nav). */
  .hero-section {
    margin-top: -5rem;
    padding-top: 5rem;
    background: #0a0805;
  }

  /* Three equal cell-image columns spanning the full-bleed hero. */
  .hero-triptych {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    background: rgba(142, 111, 62, 0.55);
    pointer-events: none;
  }
  .hero-panel {
    background-size: cover;
    background-position: center;
  }

  /* Deepen the center (behind the wordmark + lead) while letting the cells stay
     vivid toward the edges. Warm near-black so it reads Purdue, not cold. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      /* focus behind the wordmark + lead, lighter so cells stay vivid */
      radial-gradient(
        ellipse 80% 60% at 50% 50%,
        rgba(8, 6, 4, 0.6) 0%,
        rgba(8, 6, 4, 0.32) 48%,
        rgba(8, 6, 4, 0.08) 80%,
        rgba(8, 6, 4, 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(8, 6, 4, 0.24) 0%,
        rgba(8, 6, 4, 0.1) 26%,
        rgba(8, 6, 4, 0.1) 72%,
        rgba(8, 6, 4, 0.4) 100%
      );
  }

  /* ─── Centered content ─── */
  .hero-content {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
    /* Nudge the whole lockup (wordmark + lead + button) down off the exact
       vertical centre so it sits lower in the banner. translateY moves it the
       full amount, unlike padding which the flex centring would halve. */
    transform: translateY(3rem);
  }

  /* ─── "Cell to Cure" wordmark ─── */
  .hero-title {
    font-family: var(--font-cure);
    font-optical-sizing: auto;
    line-height: 0.98;
    /* margin-bottom carries extra over .hero-lead's margin-bottom because "Cure"
       and the 2's swash hang well below the title's layout box, so a plain equal
       margin would leave the lead sitting too close to the wordmark. This
       compensation makes the visual gap wordmark->lead match the lead->button gap
       (lead sits centred between the two). Tuned for the new "2" swash, which hangs
       lower than the old glyph. */
    margin: 0 0 6.8rem 0;
    /* 3-column grid pins the centre "2" to the banner's centre axis (the same
       vertical line as the OUR RESEARCH button), with Cell and Cure hugging it
       at equal gaps. A plain centred flex row would push it left of centre,
       because "Cure" is wider than "Cell" and shifts the block's midpoint. The
       two 1fr side columns are always equal, so the auto centre column — and the
       "2" inside it — lands on the exact centre regardless of word widths.
       align-items:center vertically centres the oversized numeral on the words. */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 0;
    white-space: nowrap;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.55);
  }
  .cw {
    font-size: clamp(3.6rem, 10.5vw, 7.4rem);
  }
  /* Diagonal tuck: Cell rides up-and-left into the 2's top cave, Cure drops
     down-and-right into its lower cave, so the words interlock with the numeral
     as one compact mark. The horizontal offsets are asymmetric (Cell moves left
     ~0.44em more than Cure moves right) precisely because "Cure" is that much
     wider than "Cell" — the net effect is that Cell's left edge and Cure's right
     edge sit an equal distance from the centre axis. All offsets are em-based so
     the lockup scales with the words. */
  .cw-cell {
    font-weight: 900;
    color: var(--purdue-rush);      /* Boilermaker Rush Gold */
    letter-spacing: -0.015em;
    justify-self: end;              /* right edge meets the centre axis */
    position: relative;
    z-index: 2;                     /* sit on top of the 2 */
    /* x/y position Cells within the lockup, then a shared -0.22em is folded in
       to shift the whole "Cells 2 Cures" group left ~26px so its combined
       bounding box centres on the banner axis (Cures is the wider word, so a
       group with symmetric inner edges otherwise sits ~26px right of centre).
       The same -0.22em is applied to Cures and the 2, preserving their relative
       positions while re-centring the group. */
    transform: translate(-0.29em, -0.68em);
  }
  .cw-two {
    /* Zero-width centre grid item that anchors the custom "2" on the banner's
       centre axis. The SVG is absolutely positioned, so it never widens the
       column — Cell and Cure stay symmetric about the centre. font-size tracks
       .cw so the SVG (sized in em) scales with the words. */
    font-size: clamp(3.6rem, 10.5vw, 7.4rem);
    width: 0;
    align-self: center;
    position: relative;
    z-index: 1;                     /* behind Cell + Cure */
  }
  .cw-two img {
    position: absolute;
    left: 50%;
    top: 50%;
    /* Match the old inline SVG's exact footprint: it filled a 5.6em x 2.55em box
       (preserveAspectRatio="none"), flatter than the glyph's natural 1.435 aspect.
       Setting both width and height fills the box the same way (object-fit: fill),
       so the swash no longer hangs down into the lead line below. */
    width: 3.5em;
    height: 2.25em;
    /* Opt out of Tailwind Preflight's `img { max-width: 100% }`: the img's
       positioned parent (.cw-two) is width:0, so max-width:100% would clamp
       the glyph to 0. The old inline SVG was immune (rule targets img/video). */
    max-width: none;
    /* translateX carries an optical-centering nudge beyond the -50% box centring.
       The glyph's ink centroid sits ~13% left of its bounding-box centre (the thin
       swash tail extends far right, inflating the box on that side), so a purely
       box-centred "2" reads as shifted left. The +0.3em shifts the numeral's visual
       mass onto the banner's centre axis (a fraction of the full 0.45em centroid
       offset, since the eye under-weights the faint tail). */
    transform: translate(calc(-50% + 0.3em - 0.22em), -56%);
    pointer-events: none;
    filter: drop-shadow(0 2px 20px rgba(0, 0, 0, 0.5));
  }
  .cw-cure {
    font-weight: 900;
    color: var(--cure-red);         /* deep crimson */
    letter-spacing: -0.015em;
    justify-self: start;            /* left edge meets the centre axis */
    position: relative;
    z-index: 2;                     /* sit on top of the 2 */
    /* y: dropped so Cures' "C" clears the top swash of the 2 instead of overlapping it.
       x carries the shared -0.22em group-centring shift (see .cw-cell). */
    transform: translate(-0.15em, 0.21em);
  }

  /* ─── Lead / mission line ─── */
  .hero-lead {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    line-height: 1.55;
    color: rgba(250, 247, 239, 0.96);
    max-width: 760px;
    margin: 0 auto 3.1rem auto;
    text-align: center;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.7);
  }

  /* ─── CTA (works on the dark band) ─── */
  .hero-ctas {
    display: flex;
    justify-content: center;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2.3rem;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 1.22rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1A1A1A;
    background: var(--purdue-rush);
    border: 0;
    border-radius: 3px;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.4);
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .hero-cta:hover {
    background: var(--purdue-field);
    transform: translateY(-1px);
  }

  /* Below ~640px the lead is narrow enough that a forced break after "long" would
     leave ragged lines; let the text reflow naturally there instead. */
  @media (max-width: 640px) {
    .lead-break { display: none; }
  }

  @media (max-width: 520px) {
    .cw { font-size: clamp(2.4rem, 15vw, 3.4rem); }
    /* keep the "2" image scaling with the smaller words on mobile */
    .cw-two { font-size: clamp(2.4rem, 15vw, 3.4rem); }
  }
</style>
