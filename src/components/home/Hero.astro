---
import { getImage } from 'astro:assets';
import rhoGfp from '../../assets/images/cells/rho-gfp.png';
import rhoComposite from '../../assets/images/cells/rho-composite.png';
import rhoVarGfp from '../../assets/images/cells/rho-cys110tyr-gfp.png';

const base = import.meta.env.BASE_URL;

// VarChamp Batch-13 cell images (cpg0020-varchamp), reference channel palette.
// Left -> right: RHO protein (GFP) -> RHO morphology composite -> RHO_Cys110Tyr
// protein (GFP). Served as optimized WebP from the 1080x1080 masters.
const [panelL, panelM, panelR] = await Promise.all([
  getImage({ src: rhoGfp, format: 'webp', width: 1080, quality: 82 }),
  getImage({ src: rhoComposite, format: 'webp', width: 1080, quality: 82 }),
  getImage({ src: rhoVarGfp, format: 'webp', width: 1080, quality: 82 }),
]);
---

<section class="hero-section relative min-h-screen flex items-center justify-center overflow-hidden">

  <!-- Cell-image triptych: protein -> morphology -> variant protein -->
  <div class="hero-triptych" aria-hidden="true">
    <div class="hero-panel" style={`background-image: url(${panelL.src})`}></div>
    <div class="hero-panel" style={`background-image: url(${panelM.src})`}></div>
    <div class="hero-panel" style={`background-image: url(${panelR.src})`}></div>
  </div>

  <!-- Legibility scrim: deepens the center behind the text, keeps the cells
       vivid toward the edges. No top fade, so the imagery meets the nav cleanly. -->
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="relative z-10 hero-content animate-fade-in">
    <h1 class="hero-title">
      <span class="cw cw-cell">Cell</span><span class="cw cw-to">to</span><span class="cw cw-cure">Cure</span>
    </h1>

    <p class="hero-lead">
      Very few people get to solve puzzles all day long and directly help patients suffering from disease.
    </p>

    <div class="hero-ctas">
      <a href={`${base}/#research`} class="hero-cta">Our Research</a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div id="scroll-hint"
       class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 transition-opacity duration-500">
    <span class="text-xs font-medium tracking-widest uppercase" style="font-family: var(--font-label); color: rgba(250,247,239,0.75);">Scroll</span>
    <svg class="w-4 h-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: rgba(250,247,239,0.75);">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  /* Pull the hero up under the fixed header and restore that space as padding,
     so the imagery is continuous from the very top (no seam under the nav). */
  .hero-section {
    margin-top: -5rem;
    padding-top: 5rem;
    background: #0a0805;
  }

  /* Three equal cell-image columns spanning the full-bleed hero. */
  .hero-triptych {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    background: rgba(142, 111, 62, 0.55);
    pointer-events: none;
  }
  .hero-panel {
    background-size: cover;
    background-position: center;
  }

  /* Deepen the center (behind the wordmark + lead) while letting the cells stay
     vivid toward the edges. Warm near-black so it reads Purdue, not cold. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      /* focus behind the wordmark + lead, lighter so cells stay vivid */
      radial-gradient(
        ellipse 80% 60% at 50% 50%,
        rgba(8, 6, 4, 0.6) 0%,
        rgba(8, 6, 4, 0.32) 48%,
        rgba(8, 6, 4, 0.08) 80%,
        rgba(8, 6, 4, 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(8, 6, 4, 0.24) 0%,
        rgba(8, 6, 4, 0.1) 26%,
        rgba(8, 6, 4, 0.1) 72%,
        rgba(8, 6, 4, 0.4) 100%
      );
  }

  /* ─── Centered content ─── */
  .hero-content {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
  }

  /* ─── "Cell to Cure" wordmark ─── */
  .hero-title {
    font-family: var(--font-cure);
    font-optical-sizing: auto;
    line-height: 0.98;
    margin: 0 0 1.6rem 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.28em;
    white-space: nowrap;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.55);
  }
  .cw {
    font-size: clamp(3.6rem, 10.5vw, 7.4rem);
  }
  .cw-cell {
    font-weight: 900;
    color: var(--purdue-rush);      /* Boilermaker Rush Gold */
    letter-spacing: -0.015em;
  }
  .cw-to {
    font-weight: 600;
    font-style: italic;
    font-size: clamp(2.2rem, 6vw, 4.4rem);   /* larger, more compatible */
    color: rgba(250, 247, 239, 0.92);
    letter-spacing: 0.005em;
    padding: 0 0.05em;
  }
  .cw-cure {
    font-weight: 900;
    color: #7CFF33;                 /* GFP green */
    letter-spacing: -0.015em;
  }

  /* ─── Lead / mission line ─── */
  .hero-lead {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    line-height: 1.55;
    color: rgba(250, 247, 239, 0.96);
    max-width: 760px;
    margin: 0 auto 2.5rem auto;
    text-align: center;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.7);
  }

  /* ─── CTA (works on the dark band) ─── */
  .hero-ctas {
    display: flex;
    justify-content: center;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2.3rem;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 1.22rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1A1A1A;
    background: var(--purdue-rush);
    border: 0;
    border-radius: 3px;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.4);
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .hero-cta:hover {
    background: var(--purdue-field);
    transform: translateY(-1px);
  }

  @media (max-width: 520px) {
    .hero-title { gap: 0.2em; }
    .cw { font-size: clamp(2.4rem, 15vw, 3.4rem); }
  }
</style>

<script>
  function initScrollHint() {
    const hint = document.getElementById('scroll-hint');
    if (!hint || hint.dataset.listenerAttached) return;
    hint.dataset.listenerAttached = 'true';

    let hidden = false;
    window.addEventListener('scroll', () => {
      if (!hidden && window.scrollY > 50) {
        hint.style.opacity = '0';
        hint.style.pointerEvents = 'none';
        hidden = true;
      }
    }, { passive: true });
  }

  initScrollHint();
  document.addEventListener('astro:after-swap', initScrollHint);
</script>
