---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  speaker: string;
  title: string;
  videoId: string;
  portrait: ImageMetadata;
  portraitAlt: string;
  backdrop: ImageMetadata;
  start?: number;
  portraitPosition?: string;
}

const {
  speaker,
  title,
  videoId,
  portrait,
  portraitAlt,
  backdrop,
  start = 0,
  portraitPosition = 'center',
} = Astro.props;

// Plain YouTube link is the no-JS fallback: the poster is a real <a> to the
// video, so it works with scripts blocked. When JS runs, the click handler
// below calls preventDefault() and swaps in the inline embed instead.
const watchUrl = `https://www.youtube.com/watch?v=${videoId}${start > 0 ? `&t=${start}s` : ''}`;
---

<article
  class="video-card"
  data-video-card
  data-video-id={videoId}
  data-video-start={start}
  data-video-title={`${speaker}: ${title}`}
>
  <div class="video-stage">
    <a
      class="video-trigger"
      href={watchUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Play ${title}, presented by ${speaker}`}
    >
      <span class="video-poster" aria-hidden="true">
        <span class="poster-cells">
          <Image
            src={backdrop}
            alt=""
            widths={[360, 640, 900]}
            sizes="(max-width: 767px) 42vw, 20vw"
            loading="lazy"
          />
        </span>
        <span class="poster-portrait" style={`--portrait-position: ${portraitPosition};`}>
          <Image
            src={portrait}
            alt={portraitAlt}
            widths={[420, 720, 1000]}
            sizes="(max-width: 767px) 58vw, 30vw"
            loading="lazy"
          />
        </span>
        <span class="poster-shade"></span>
        <span class="play-control">
          <span class="play-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8.5 5.7v12.6L18 12 8.5 5.7Z" fill="currentColor" />
            </svg>
          </span>
          <span class="play-label">Play talk</span>
        </span>
      </span>
    </a>
  </div>

  <div class="video-details">
    <p class="video-speaker">{speaker}</p>
    <h3 class="video-title">{title}</h3>
  </div>
</article>

<script>
  function initializeVideoCards() {
    document.querySelectorAll<HTMLElement>('[data-video-card]').forEach((card) => {
      if (card.dataset.videoReady === 'true') return;

      const trigger = card.querySelector<HTMLAnchorElement>('.video-trigger');
      const stage = card.querySelector<HTMLElement>('.video-stage');
      if (!trigger || !stage) return;

      card.dataset.videoReady = 'true';
      trigger.addEventListener('click', (event) => {
        // Intercept only a plain left-click so modifier/middle clicks still
        // open the YouTube link in a new tab as the anchor normally would.
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();

        const videoId = card.dataset.videoId;
        const title = card.dataset.videoTitle ?? 'Research talk';
        const start = Number(card.dataset.videoStart ?? 0);
        if (!videoId) return;

        const parameters = new URLSearchParams({
          autoplay: '1',
          rel: '0',
        });
        if (start > 0) parameters.set('start', String(start));

        const iframe = document.createElement('iframe');
        iframe.className = 'video-frame';
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?${parameters.toString()}`;
        iframe.title = title;
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allowFullscreen = true;

        stage.replaceChildren(iframe);
        iframe.focus();
      });
    });
  }

  initializeVideoCards();
  document.addEventListener('astro:page-load', initializeVideoCards);
</script>

<style>
  .video-card {
    overflow: hidden;
    border: 1px solid var(--border-card);
    border-radius: 12px;
    background: var(--bg-card);
    box-shadow: 0 10px 32px rgba(26, 26, 26, 0.06);
  }

  .video-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--text-primary);
  }

  .video-trigger {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .video-trigger:focus-visible {
    position: relative;
    z-index: 2;
    outline: 4px solid var(--purdue-aged);
    outline-offset: -4px;
  }

  .video-poster {
    position: relative;
    display: grid;
    grid-template-columns: 42% 58%;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .poster-cells,
  .poster-portrait {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }

  .poster-cells {
    background: var(--text-primary);
  }

  .poster-cells::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(26, 26, 26, 0.34), rgba(26, 26, 26, 0.04)),
      rgba(142, 111, 62, 0.2);
  }

  .poster-cells :global(img),
  .poster-portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .poster-cells :global(img) {
    filter: saturate(0.7) contrast(1.05);
  }

  .poster-portrait :global(img) {
    object-position: var(--portrait-position);
  }

  .poster-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(26, 26, 26, 0.1) 0%, transparent 48%),
      linear-gradient(0deg, rgba(26, 26, 26, 0.22) 0%, transparent 42%);
    pointer-events: none;
  }

  .play-control {
    position: absolute;
    left: 42%;
    bottom: clamp(1rem, 3vw, 1.6rem);
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    transform: translateX(-1.35rem);
    color: var(--bg-card);
  }

  .play-icon {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    background: var(--text-primary);
    box-shadow: 0 8px 24px rgba(26, 26, 26, 0.22);
    transition:
      background 0.2s ease,
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .play-icon svg {
    width: 1.2rem;
    height: 1.2rem;
    transform: translateX(1px);
  }

  .play-label {
    padding: 0.45rem 0.7rem;
    background: var(--text-primary);
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .video-trigger:hover .poster-cells :global(img),
  .video-trigger:hover .poster-portrait :global(img) {
    transform: scale(1.025);
  }

  .video-trigger:hover .play-icon {
    background: var(--purdue-aged);
    transform: scale(1.06);
  }

  .video-details {
    padding: 1.35rem 1.5rem 1.55rem;
  }

  .video-speaker {
    margin: 0 0 0.5rem;
    color: var(--purdue-aged);
    font-family: var(--font-label);
    font-size: clamp(0.88rem, 1vw, 0.96rem);
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.3;
    text-align: left;
    text-transform: uppercase;
  }

  .video-title {
    margin: 0;
    color: var(--text-heading);
    font-family: var(--font-heading);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    font-weight: 600;
    line-height: 1.4;
  }

  .video-stage :global(.video-frame) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 520px) {
    .video-poster {
      grid-template-columns: 38% 62%;
    }

    .play-control {
      left: 38%;
    }

    .play-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-cells :global(img),
    .poster-portrait :global(img),
    .play-icon {
      transition: none;
    }

    .video-trigger:hover .poster-cells :global(img),
    .video-trigger:hover .poster-portrait :global(img) {
      transform: none;
    }
  }
</style>
